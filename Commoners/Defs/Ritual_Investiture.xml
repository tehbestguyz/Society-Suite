<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Investiture: makes a noble's pending landed title official (Source/LandedTitles.cs).
       A hidden ritual like vanilla's role change: visible=false and countsTowardsPreceptLimit=false make
       every ideoligion get it, and Ideo adds it on load to ideoligions from before this mod version.
       It's started from the noble's "Investiture" gizmo, which locks them in as the investee.

       Stages, modeled on the trial: the investor stands behind the altar or spot and the noble in front
       of it (1, ends when both arrive or after 25%), then the investor speaks (2, the rest). -->

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_Investiture</defName>
    <label>investiture</label>
    <description>A ceremony that makes a noble's new landed title official. The investor addresses the gathering and bestows the title while the noble stands before them.</description>
    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
    <ritualPatternBase>CM_Investiture</ritualPatternBase>
    <iconPath>UI/Commoners/Investiture</iconPath>
    <visible>false</visible>
    <useRepeatPenalty>false</useRepeatPenalty>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <classic>true</classic>
  </PreceptDef>

  <RitualPatternDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_Investiture</defName>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualObligationTargetFilter>RitualSpotIdeogramOrAltar</ritualObligationTargetFilter>
    <ritualTargetFilter>AltarIdeogramOrRitualSpot</ritualTargetFilter>
    <ritualBehavior>CM_Investiture</ritualBehavior>
    <ritualOnlyForIdeoMembers>false</ritualOnlyForIdeoMembers>
    <ritualOutcomeEffect>CM_Investiture</ritualOutcomeEffect>
  </RitualPatternDef>

  <RitualBehaviorDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_Investiture</defName>
    <workerClass>Commoners.RitualBehaviorWorker_Investiture</workerClass>
    <durationTicks>5000</durationTicks>
    <roles>
      <li Class="Commoners.RitualRole_Investee">
        <label>noble</label>
        <missingDesc>a noble with a title to receive</missingDesc>
        <id>investee</id>
        <maxCount>1</maxCount>
        <required>True</required>
        <countsAsParticipant>False</countsAsParticipant>
        <allowChild>false</allowChild>
        <allowOtherIdeos>true</allowOtherIdeos>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
      </li>
      <li Class="Commoners.RitualRole_Investor">
        <label>investor</label>
        <missingDesc>someone to invest them (the leader, a titled noble or the moral guide)</missingDesc>
        <id>investor</id>
        <maxCount>1</maxCount>
        <required>True</required>
        <countsAsParticipant>False</countsAsParticipant>
        <allowChild>false</allowChild>
        <allowOtherIdeos>true</allowOtherIdeos>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <endTriggers>
          <li Class="Commoners.StageEndTrigger_AllRolePawnsTagged">
            <roleIds>
              <li>investee</li>
              <li>investor</li>
            </roleIds>
            <tag>Arrived</tag>
          </li>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.25</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>investor</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_BehindThingCenter" />
            </customPositions>
          </li>
          <li>
            <roleId>investee</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_InFrontThingCenter" />
            </customPositions>
          </li>
        </roleBehaviors>
        <highlightRolePawns>
          <li>investee</li>
          <li>investor</li>
        </highlightRolePawns>
      </li>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <allowedSpectateSidesOverride>Horizontal</allowedSpectateSidesOverride>
        <spectateDistanceOverride>1</spectateDistanceOverride>
        <ignoreDurationToFinishAfterStage>true</ignoreDurationToFinishAfterStage>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.75</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>investor</roleId>
            <dutyDef>SpeakOnCell</dutyDef>
            <speakerInteraction>CM_Speech_Investiture</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_BehindThingCenter" />
            </customPositions>
          </li>
          <li>
            <roleId>investee</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <jobReportOverride>receiving a title</jobReportOverride>
            <customPositions>
              <li Class="RitualPosition_InFrontThingCenter" />
            </customPositions>
          </li>
        </roleBehaviors>
        <highlightRolePawns>
          <li>investee</li>
          <li>investor</li>
        </highlightRolePawns>
        <visualEffectDef>Speech</visualEffectDef>
      </li>
    </stages>
  </RitualBehaviorDef>

  <InteractionDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_Speech_Investiture</defName>
    <label>investiture speech</label>
    <workerClass>InteractionWorker</workerClass>
    <ignoreTimeSinceLastInteraction>True</ignoreTimeSinceLastInteraction>
    <symbol>Things/Mote/SpeechSymbols/Speech</symbol>
    <logRulesInitiator>
      <include><li>SpeechUtility</li></include>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] [spokeof] [speechtopic].</li>

        <li>speechtopic->the duties a lord owes their people</li>
        <li>speechtopic->the deeds that earned the title</li>
        <li>speechtopic->the land and those who work it</li>
        <li>speechtopic->loyalty and its rewards</li>
        <li>speechtopic->the founders of the realm</li>
        <li>speechtopic->the weight of a crown</li>
        <li>speechtopic->justice and mercy</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>

  <RitualOutcomeEffectDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_Investiture</defName>
    <description>The noble receives their title. Depending on ritual quality, participants will get between {MINMOOD} and {MAXMOOD} mood for {MOODDAYS} days.</description>
    <workerClass>Commoners.RitualOutcomeEffectWorker_Investiture</workerClass>
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1, 0.05)</li>
            <li>(5, 0.2)</li>
            <li>(10, 0.35)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_PawnStatScaled">
        <label>{PAWN_labelShort}'s social impact</label>
        <labelAbstract>investor's social impact</labelAbstract>
        <roleId>investor</roleId>
        <statDef>SocialImpact</statDef>
        <curve>
          <points>
            <li>(0.2, 0.0)</li>
            <li>(0.6, 0.15)</li>
            <li>(1.0, 0.25)</li>
            <li>(1.5, 0.3)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_RoomStat">
        <label>room impressiveness</label>
        <statDef>Impressiveness</statDef>
        <curve>
          <points>
            <li>0,  0</li>
            <li>50,  0.1</li>
            <li>120, 0.25</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Shabby</label>
        <chance>0.05</chance>
        <memory>CM_InvestitureShabby</memory>
        <description>The {0} was shabby. Nobody believed a word of it.</description>
        <positivityIndex>-2</positivityIndex>
      </li>
      <li>
        <label>Plain</label>
        <chance>0.15</chance>
        <memory>CM_InvestiturePlain</memory>
        <description>The {0} was plain. The title was given, and that was all.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Dignified</label>
        <chance>0.6</chance>
        <memory>CM_InvestitureDignified</memory>
        <description>The {0} was dignified. Everyone left feeling the realm was in good hands.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Glorious</label>
        <chance>0.2</chance>
        <memory>CM_InvestitureGlorious</memory>
        <description>The {0} was glorious! It will be remembered for generations.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_InvestitureShabby</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>shabby investiture</label>
        <description>That investiture was an embarrassment. Is that what titles are worth now?</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_InvestiturePlain</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>plain investiture</label>
        <description>A title was given. It could have been more of an occasion.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_InvestitureDignified</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>dignified investiture</label>
        <description>A fine ceremony. Our realm has worthy rulers.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_InvestitureGlorious</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>glorious investiture</label>
        <description>What a ceremony! I'll tell my grandchildren I was there.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- The invested noble's own memory, on top of the ceremony's. -->
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>CM_InvestedWithTitle</defName>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>invested with a title</label>
        <description>The realm has honored me with a new title. I've earned it.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
